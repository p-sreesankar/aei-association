rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ── Mock test catalog (admin-managed) ─────────────────────
    match /mockTests/{testId} {
      allow read: if isSignedIn();                // Only authenticated users can browse tests
      allow create, update, delete: if isAdmin();  // Only admins manage tests
    }

    // ── Mock test submissions ─────────────────────────────────
    match /mockTestSubmissions/{submissionId} {
      // Admins can read all submissions
      // Authenticated users can read their own submissions
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.submittedByUid == request.auth.uid);

      // Authenticated users can create only their own submissions
      allow create: if isSignedIn()
            && request.resource.data.submittedByUid == request.auth.uid;

      // Only admins can update or delete submissions
      allow update, delete: if isAdmin();
    }

    // ── Content sync (read-only for app, written by server SDK) ──
    match /content/{document=**} {
      allow read: if true;
      allow write: if false;  // Only server SDK (admin) can write
    }

    // ── Asset manifest (read-only) ────────────────────────────
    match /assets/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Default deny ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
