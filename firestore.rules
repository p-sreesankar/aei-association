rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ── Mock test catalog ─────────────────────────────────────
    // WRITE access restricted to admins only to prevent data tampering
    match /mockTests/{testId} {
      allow read: if isSignedIn();                // Only authenticated users can browse tests
      allow create, update, delete: if isAdmin(); // Only admins can manage tests
    }

    // Learner attempts are stored only in the browser and are not written to Firestore.

    // ── Content sync (read-only for app, written by server SDK) ──
    match /content/{document=**} {
      allow read: if true;
      allow write: if false;  // Only server SDK (admin) can write
    }

    // ── Asset manifest (read-only) ────────────────────────────
    match /assets/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Default deny ──────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
